#!/usr/bin/env python3
import json
import subprocess
from pathlib import Path

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import Gtk, GtkLayerShell

DNS_SERVERS = {
    "cloudflare": "1.1.1.1 1.0.0.1",
    "google": "8.8.8.8 8.8.4.4",
}


def fetch():
    try:
        return json.loads(subprocess.check_output(["flux-network"], text=True, timeout=6))
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError):
        return {"label": "Disconnected", "type": "none"}


def set_dns(con, provider, servers=None):
    if provider == "dhcp":
        subprocess.run(["nmcli", "con", "mod", con, "ipv4.ignore-auto-dns", "no", "ipv4.dns", ""])
    else:
        subprocess.run(["nmcli", "con", "mod", con, "ipv4.ignore-auto-dns", "yes",
                         "ipv4.dns", servers if provider == "custom" else DNS_SERVERS[provider]])
    subprocess.run(["nmcli", "con", "up", con])


def stat_row(grid, row, l1, v1, l2, v2):
    def cell(label, value):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        lbl = Gtk.Label(label=label, xalign=0)
        lbl.get_style_context().add_class("stat-label")
        val = Gtk.Label(label=value, xalign=0)
        val.get_style_context().add_class("stat-value")
        box.pack_start(lbl, False, False, 0)
        box.pack_start(val, False, False, 0)
        return box

    grid.attach(cell(l1, v1), 0, row, 1, 1)
    grid.attach(cell(l2, v2), 1, row, 1, 1)


def build_content(app, window, data):
    for child in window.get_children():
        window.remove(child)

    outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
    outer.set_border_width(16)

    header = Gtk.Box(spacing=8)
    title_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
    title = Gtk.Label(label=data.get("label", "Network"), xalign=0)
    title.get_style_context().add_class("title")
    subtitle = Gtk.Label(label=data.get("iface", "").upper(), xalign=0)
    subtitle.get_style_context().add_class("stat-label")
    title_box.pack_start(title, False, False, 0)
    title_box.pack_start(subtitle, False, False, 0)
    header.pack_start(title_box, True, True, 0)
    outer.pack_start(header, False, False, 0)

    if data.get("type") == "none":
        outer.pack_start(Gtk.Label(label="Not connected"), False, False, 0)
        window.add(outer)
        window.show_all()
        return

    grid = Gtk.Grid(row_spacing=10, column_spacing=24)
    stat_row(grid, 0, "PING", f"{data['ping_ms']} ms", "PACKET LOSS", f"{data['loss_pct']}%")
    stat_row(grid, 1, "RECEIVING", data["rx_rate"], "SENDING", data["tx_rate"])
    stat_row(grid, 2, "DOWNLOADED", data["rx_total"], "UPLOADED", data["tx_total"])
    stat_row(grid, 3, "IP ADDRESS", data["ip"] or "--", "GATEWAY", data["gateway"] or "--")
    outer.pack_start(grid, False, False, 0)

    con = data.get("connection")
    if con and con != "--":
        outer.pack_start(Gtk.Label(label="DNS PROVIDER", xalign=0), False, False, 0)
        btn_box = Gtk.Box(spacing=8, homogeneous=True)
        for key, name in (("dhcp", "DHCP"), ("cloudflare", "Cloudflare"),
                           ("google", "Google"), ("custom", "Custom")):
            btn = Gtk.Button(label=name)
            btn.get_style_context().add_class("dns-btn")
            if data.get("dns") == key:
                btn.get_style_context().add_class("active")
            if key == "custom":
                btn.connect("clicked", lambda _b: toggle_custom_row(app, window, data))
            else:
                btn.connect("clicked", lambda _b, p=key: (set_dns(con, p), refresh(app, window)))
            btn_box.pack_start(btn, True, True, 0)
        outer.pack_start(btn_box, False, False, 0)

        if getattr(window, "custom_dns_open", False):
            row = Gtk.Box(spacing=6)
            entry = Gtk.Entry()
            entry.set_placeholder_text("9.9.9.9 149.112.112.112")
            entry.set_text(data.get("dns_servers", "") if data.get("dns") == "custom" else "")
            apply_btn = Gtk.Button(label="Apply")
            apply_btn.get_style_context().add_class("dns-btn")

            def apply(*_a):
                text = entry.get_text().strip()
                if text:
                    set_dns(con, "custom", text)
                    window.custom_dns_open = False
                    refresh(app, window)

            entry.connect("activate", apply)
            apply_btn.connect("clicked", apply)
            row.pack_start(entry, True, True, 0)
            row.pack_start(apply_btn, False, False, 0)
            outer.pack_start(row, False, False, 0)

    window.add(outer)
    window.show_all()


def refresh(app, window):
    build_content(app, window, fetch())


def toggle_custom_row(app, window, data):
    window.custom_dns_open = not getattr(window, "custom_dns_open", False)
    build_content(app, window, data)


def activate(app):
    if windows := app.get_windows():
        windows[0].destroy()
        return

    window = Gtk.ApplicationWindow(application=app)
    window.set_name("network-popup")
    window.set_decorated(False)
    window.set_resizable(False)

    GtkLayerShell.init_for_window(window)
    GtkLayerShell.set_namespace(window, "network-popup")
    GtkLayerShell.set_layer(window, GtkLayerShell.Layer.OVERLAY)
    GtkLayerShell.set_anchor(window, GtkLayerShell.Edge.TOP, True)
    GtkLayerShell.set_anchor(window, GtkLayerShell.Edge.RIGHT, True)
    GtkLayerShell.set_margin(window, GtkLayerShell.Edge.TOP, 40)
    GtkLayerShell.set_margin(window, GtkLayerShell.Edge.RIGHT, 12)
    GtkLayerShell.set_keyboard_interactivity(window, GtkLayerShell.KeyboardMode.ON_DEMAND)

    theme = Path.home() / ".config/fluxlinux/theme/waybar-colors.css"
    css = f"""
        @import url("{theme.as_uri()}");
        #network-popup {{ background: @bg; border: 1px solid @accent; color: @fg; }}
        #network-popup .title {{ font-weight: bold; font-size: 1.1em; }}
        #network-popup .stat-label {{ color: @muted; font-size: 0.8em; }}
        #network-popup .stat-value {{ color: @accent; font-weight: bold; }}
        #network-popup .dns-btn {{ background: @surface; color: @fg; border: 1px solid @surface; }}
        #network-popup .dns-btn.active {{ border-color: @accent; color: @accent; }}
    """
    provider = Gtk.CssProvider()
    provider.load_from_data(css.encode())
    Gtk.StyleContext.add_provider_for_screen(
        window.get_screen(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
    )

    build_content(app, window, fetch())


app = Gtk.Application(application_id="org.fluxlinux.Network")
app.connect("activate", activate)
app.run()
