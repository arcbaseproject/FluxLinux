#!/usr/bin/env python3
import calendar
import datetime
from pathlib import Path

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import Gtk, GtkLayerShell

WEEKDAYS = ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"]


def build_content(today):
    outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
    outer.set_border_width(20)

    header = Gtk.Box(spacing=10)
    icon = Gtk.Label(label="")
    icon.get_style_context().add_class("cal-icon")
    title = Gtk.Label(label=today.strftime("%B %-d"), xalign=0)
    title.get_style_context().add_class("cal-title")
    header.pack_start(icon, False, False, 0)
    header.pack_start(title, False, False, 0)
    outer.pack_start(header, False, False, 0)

    year_start = datetime.date(today.year, 1, 1)
    days_in_year = (datetime.date(today.year, 12, 31) - year_start).days + 1
    progress = (today.timetuple().tm_yday) / days_in_year

    progress_row = Gtk.Box(spacing=10)
    year_label = Gtk.Label(label=str(today.year))
    year_label.get_style_context().add_class("cal-muted")
    bar = Gtk.ProgressBar()
    bar.set_fraction(progress)
    bar.set_hexpand(True)
    bar.get_style_context().add_class("cal-progress")
    pct_label = Gtk.Label(label=f"{round(progress * 100)}%")
    pct_label.get_style_context().add_class("cal-muted")
    progress_row.pack_start(year_label, False, False, 0)
    progress_row.pack_start(bar, True, True, 0)
    progress_row.pack_start(pct_label, False, False, 0)
    outer.pack_start(progress_row, False, False, 0)

    grid = Gtk.Grid(row_spacing=8, column_spacing=14)
    w_hdr = Gtk.Label(label="W")
    w_hdr.get_style_context().add_class("cal-dow")
    grid.attach(w_hdr, 0, 0, 1, 1)
    for col, name in enumerate(WEEKDAYS, start=1):
        lbl = Gtk.Label(label=name)
        lbl.get_style_context().add_class("cal-dow")
        grid.attach(lbl, col, 0, 1, 1)

    cal = calendar.Calendar(firstweekday=6)
    for row, week in enumerate(cal.monthdatescalendar(today.year, today.month), start=1):
        wk_lbl = Gtk.Label(label=str(week[0].isocalendar()[1]))
        wk_lbl.get_style_context().add_class("cal-weeknum")
        grid.attach(wk_lbl, 0, row, 1, 1)
        for col, day in enumerate(week, start=1):
            lbl = Gtk.Label(label=str(day.day))
            ctx = lbl.get_style_context()
            ctx.add_class("cal-day")
            if day.month != today.month:
                ctx.add_class("cal-day-outside")
            if day == today:
                ctx.add_class("cal-day-today")
            grid.attach(lbl, col, row, 1, 1)
    outer.pack_start(grid, False, False, 0)

    footer = Gtk.Label(label=today.strftime("%B %Y").upper())
    footer.get_style_context().add_class("cal-footer")
    outer.pack_start(footer, False, False, 0)

    return outer


def activate(app):
    if windows := app.get_windows():
        windows[0].destroy()
        return

    window = Gtk.ApplicationWindow(application=app)
    window.set_name("calendar-popup")
    window.set_decorated(False)
    window.set_resizable(False)

    GtkLayerShell.init_for_window(window)
    GtkLayerShell.set_namespace(window, "calendar-popup")
    GtkLayerShell.set_layer(window, GtkLayerShell.Layer.OVERLAY)
    GtkLayerShell.set_anchor(window, GtkLayerShell.Edge.TOP, True)
    GtkLayerShell.set_margin(window, GtkLayerShell.Edge.TOP, 40)
    GtkLayerShell.set_keyboard_interactivity(window, GtkLayerShell.KeyboardMode.NONE)

    theme = Path.home() / ".config/fluxlinux/theme/waybar-colors.css"
    css = f"""
        @import url("{theme.as_uri()}");
        #calendar-popup {{ background: @bg; border: 1px solid @accent; color: @fg; }}
        #calendar-popup .cal-icon {{ color: @accent; font-size: 1.4em; }}
        #calendar-popup .cal-title {{ color: @accent; font-weight: bold; font-size: 1.8em; }}
        #calendar-popup .cal-muted {{ color: @muted; font-size: 0.85em; }}
        #calendar-popup .cal-progress trough {{ background: @surface; min-height: 4px; }}
        #calendar-popup .cal-progress progress {{ background: @accent; min-height: 4px; }}
        #calendar-popup .cal-dow {{ color: @muted; font-size: 0.75em; }}
        #calendar-popup .cal-weeknum {{ color: @muted; font-size: 0.75em; }}
        #calendar-popup .cal-day {{ color: @fg; padding: 4px 8px; }}
        #calendar-popup .cal-day-outside {{ color: @muted; }}
        #calendar-popup .cal-day-today {{ font-weight: bold; color: @accent; border: 1px solid @accent; border-radius: 4px; }}
        #calendar-popup .cal-footer {{ color: @muted; font-size: 0.85em; padding-top: 4px; }}
    """
    provider = Gtk.CssProvider()
    provider.load_from_data(css.encode())
    Gtk.StyleContext.add_provider_for_screen(
        window.get_screen(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
    )

    window.add(build_content(datetime.date.today()))
    window.show_all()


app = Gtk.Application(application_id="org.fluxlinux.Calendar")
app.connect("activate", activate)
app.run()
