#!/usr/bin/env bash
# Render and apply a FluxLinux theme (colors + wallpaper) to Hyprland, hyprlock,
# kitty, mako and waybar. Safe to run without a live Hyprland session (e.g. at
# install time): the rendered files are always regenerated, but live-reload
# commands are only sent when a compositor session is actually running.
set -euo pipefail

name="${1:?Usage: flux-theme-set <theme-name>}"

THEME_DIR=""
for dir in "$HOME/.config/fluxlinux/themes" /usr/share/fluxlinux/themes; do
  if [[ -d "$dir/$name" ]]; then
    THEME_DIR="$dir/$name"
    break
  fi
done
[[ -n "$THEME_DIR" ]] || { echo "Unknown theme: $name" >&2; exit 1; }

# shellcheck source=/dev/null
source "$THEME_DIR/colors.sh"

RENDER_DIR="$HOME/.config/fluxlinux/theme"
mkdir -p "$RENDER_DIR" "$HOME/.config/mako" "$HOME/.local/state/fluxlinux"

cat > "$RENDER_DIR/hyprland-colors.lua" <<EOF
-- Generated by flux-theme-set — do not edit, re-run: flux-theme-set <name>
hl.config({
  general = {
    col = {
      active_border = { colors = { "rgba(${ACCENT}ee)", "rgba(${ACCENT}66)" }, angle = 45 },
      inactive_border = "rgba(${MUTED}66)",
    },
  },
})
EOF

cat > "$RENDER_DIR/hyprlock-colors.conf" <<EOF
# Generated by flux-theme-set — do not edit
\$flux_bg = rgba(${BG}ee)
\$flux_bg_solid = rgba(${BG}ff)
\$flux_surface = rgba(${SURFACE}ff)
\$flux_fg = rgba(${FG}ff)
\$flux_accent = rgba(${ACCENT}ff)
\$flux_muted = rgba(${MUTED}ff)
\$flux_muted_hex = #${MUTED}
EOF

cat > "$RENDER_DIR/kitty-colors.conf" <<EOF
# Generated by flux-theme-set — do not edit
background #${BG}
foreground #${FG}
cursor #${ACCENT}
selection_background #${ACCENT}
selection_foreground #${BG}
url_color #${ACCENT}
EOF

cat > "$RENDER_DIR/waybar-colors.css" <<EOF
/* Generated by flux-theme-set — do not edit */
@define-color bg #${BG};
@define-color fg #${FG};
@define-color accent #${ACCENT};
@define-color muted #${MUTED};
@define-color surface #${SURFACE};
EOF

shopt -s nullglob
wallpapers=("$THEME_DIR"/*.{png,webp,jpg,jpeg})
if ((${#wallpapers[@]})); then
  # Re-encode rather than symlink: flux-background-menu writes this same fixed
  # path from webp/jpg sources too, so it always has to go through a real
  # conversion — keep theme-set on the same path for one code path, not two.
  magick "${wallpapers[0]}" "$RENDER_DIR/wallpaper.png"
else
  # ponytail: themes without images keep their colors but have no wallpaper.
  rm -f "$RENDER_DIR/wallpaper.png"
fi

mkdir -p "$HOME/.config/fuzzel"
cat > "$HOME/.config/fuzzel/fuzzel.ini" <<EOF
# Generated by flux-theme-set — do not edit, re-run: flux-theme-set <name>

[main]
font=monospace:size=12
dpi-aware=auto
terminal=kitty
prompt=
placeholder=Go…
icon-theme=hicolor
icons-enabled=yes
lines=10
minimal-lines=yes
width=26
horizontal-pad=18
vertical-pad=18
inner-pad=6
line-height=32

[border]
width=2
radius=0
selection-radius=0

[key-bindings]
prev=Up
next=Down

[colors]
background=${BG}ff
text=${FG}ff
placeholder=${MUTED}ff
prompt=${FG}94
input=${FG}ff
match=${ACCENT}ff
selection=${FG}14
selection-text=${ACCENT}ff
selection-match=${ACCENT}ff
counter=${MUTED}ff
border=${FG}ff
EOF

cat > "$HOME/.config/mako/config" <<EOF
# Generated by flux-theme-set — do not edit, re-run: flux-theme-set <name>
font=monospace 10
background-color=#${BG}ee
text-color=#${FG}
border-color=#${ACCENT}
border-size=2
border-radius=10
padding=12
default-timeout=5000

[mode=silent]
invisible=1
EOF

echo "$name" > "$HOME/.local/state/fluxlinux/current-theme.name"

if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
  hyprctl reload >/dev/null 2>&1 || true
  hyprctl hyprpaper wallpaper ",$RENDER_DIR/wallpaper.png,cover" >/dev/null 2>&1 || setsid -f hyprpaper >/dev/null 2>&1
  pkill -SIGUSR1 kitty 2>/dev/null || true
  makoctl reload >/dev/null 2>&1 || true
  pkill waybar 2>/dev/null || true
  (setsid waybar >/dev/null 2>&1 &)
fi

echo "Theme set to ${LABEL:-$name}"
